# Página de error personalizada
ErrorDocument 403 /itv/acceso-restringido.php

# Bloquear todos los .json excepto manifest.json
<FilesMatch "^(?!manifest\.json$).*\.json$">
  Require all denied
</FilesMatch>

# Bloquear todos los .log excepto logs sensibles que PHP necesita escribir
<FilesMatch "^(?!ips_bloqueadas\.log$)(?!ips_permanentemente_bloqueadas\.log$).*\.log$">
  Require all denied
</FilesMatch>

# Bloquear acceso HTTP directo a los logs sensibles
<Files "ips_bloqueadas.log">
  Require all denied
</Files>

<Files "ips_permanentemente_bloqueadas.log">
  Require all denied
</Files>

# Permitir PHP, recursos y directorios; bloquear todo lo demás
<FilesMatch ".*">
  <If "-d %{REQUEST_FILENAME}">
    Require all granted
  </If>
  <ElseIf "%{REQUEST_FILENAME} =~ /(manifest\.json|\.php|\.css|\.js|\.jpg|\.jpeg|\.png|\.gif|\.svg|\.webp)$/i">
    Require all granted
  </ElseIf>
  <Else>
    Require all denied
  </Else>
</FilesMatch>
