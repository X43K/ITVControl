<?php
// ============================================================
// Script para asignar IDs únicos (id_cita) a las citas sin ID
// Formato: tres últimos dígitos del año + AA + número secuencial
// Ejemplo: 026AA000, 026AA001, ...
// ============================================================

$citas_file = 'citas.json';

if (!file_exists($citas_file)) {
    die("❌ No se encontró el archivo citas.json");
}

$citas = json_decode(file_get_contents($citas_file), true);
if (!is_array($citas)) {
    die("❌ El archivo citas.json no contiene un formato válido.");
}

$anio = substr(date('Y'), -3);
$prefijo = 'AA';

// Buscar el último número ya usado
$ultimo_num = 0;
foreach ($citas as $c) {
    if (isset($c['id_cita']) && preg_match('/^'.$anio.$prefijo.'(\d{3})$/', $c['id_cita'], $m)) {
        $num = intval($m[1]);
        if ($num > $ultimo_num) $ultimo_num = $num;
    }
}

$nuevas = 0;
foreach ($citas as &$cita) {
    if (!isset($cita['id_cita']) || trim($cita['id_cita']) === '') {
        $cita['id_cita'] = $anio.$prefijo.str_pad(++$ultimo_num, 3, '0', STR_PAD_LEFT);
        $nuevas++;
    }
}

if ($nuevas > 0) {
    file_put_contents($citas_file, json_encode($citas, JSON_PRETTY_PRINT));
    echo "✅ Se añadieron $nuevas ID(s) de cita correctamente.\n";
} else {
    echo "ℹ️ Todas las citas ya tienen un id_cita. No se realizaron cambios.\n";
}
?>
